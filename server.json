{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.justinmont84/loyaltyvip",
  "description": "U.S. casino directory + a player's loyalty data, comps, tiers, and gambling tax docs.",
  "repository": {
    "url": "https://github.com/movaMedia-Inc/loyaltyvip-js",
    "source": "github"
  },
  "version": "1.0.0",
  "websiteUrl": "https://loyaltyvip.com/developers",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@loyaltyvip/mcp",
      "version": "1.0.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "LOYALTYVIP_API_KEY",
          "description": "Personal API key (lvip_live_...). Optional; needed only for a player's own data.",
          "isSecret": true,
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://loyaltyvip.com/mcp"
    }
  ]
}
